{
  "name": "signalk-wilhelmsk-docs",
  "version": "0.1.5",
  "description": "Serves the WilhelmSK app documentation from your SignalK server, so in-app help and direct browser access work without an internet connection. Open it from the Webapps menu or browse to /signalk-wilhelmsk-docs/.",
  "main": "index.js",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "test": "echo \"No tests yet\" && exit 0",
    "build-docs": "cd .. && mkdocs build --strict -d plugin/public/ && node plugin/scripts/gen-info.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk-category-instruments",
    "signalk-category-notifications",
    "signalk-category-ais",
    "wilhelmsk",
    "documentation"
  ],
  "author": "David Lewis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dglcinc/signalk-wilhelmsk-docs.git"
  },
  "engines": {
    "node": ">=18"
  },
  "signalk": {
    "displayName": "WilhelmSK Documentation",
    "appIcon": "icon.png",
    "screenshots": [
      "screenshot.png"
    ],
    "appSupport": "https://github.com/dglcinc/signalk-wilhelmsk-docs/issues"
  },
  "files": [
    "index.js",
    "public/",
    "README.md",
    "CHANGELOG.md"
  ]
}
